// Prisma schema for AI Shopkeeper Assistant.
// See docs/architecture.md for the storage model and invariants.
//
// Quantities are stored as integer thousandths of a unit (1.5 kg = 1500) so
// that stock arithmetic is exact. Money is stored as integer paisa.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// A shop user. v1 seeds one OWNER. Cashiers are a later phase.
model User {
  id           String   @id @default(cuid())
  /// Lowercased login name, unique across the installation.
  username     String   @unique
  name         String?
  /// bcrypt hash; the plain password is never stored.
  passwordHash String
  /// OWNER | CASHIER
  role         String   @default("OWNER")
  /// Incremented when the password changes, invalidating existing sessions.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// The single shop this installation serves.
model Shop {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("PKR")
  timezone  String   @default("Asia/Karachi")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A sellable item. Stock is never written directly: every change goes through
/// a StockMovement in the same transaction (invariant 6).
model Product {
  id        String  @id @default(cuid())
  name      String
  /// Lowercased, whitespace-collapsed name used to reject near-duplicates.
  nameNormalized String @unique
  category  String?
  barcode   String? @unique
  /// kg | litre | piece | packet
  unit      String
  costPricePaisa Int
  salePricePaisa Int
  /// Cached stock in thousandths of `unit`. Recomputed by reconcileStock().
  stockMilli Int @default(0)
  /// Alert threshold in thousandths of `unit`.
  lowStockMilli Int @default(0)
  imagePath String?
  isActive  Boolean  @default(true)
  /// Set when a product is created from an assistant proposal. Unique so a
  /// replayed confirmation cannot create a second product (Phase 7).
  proposalId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases        ProductAlias[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([isActive, name])
  @@map("products")
}

/// Alternative names for a product, so search matches how people actually talk.
model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  alias     String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, alias])
  @@index([alias])
  @@map("product_aliases")
}

/// An immutable record of a stock change. `quantityMilli` is signed:
/// positive for stock coming in, negative for stock going out.
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  quantityMilli Int
  /// OPENING | RESTOCK | DAMAGE | CORRECTION | OTHER | SALE | VOID | RETURN
  reason        String
  /// Source record id (sale id, etc.) when applicable.
  reference     String?
  note          String?
  /// Set when stock is changed from an assistant proposal. Unique so a
  /// replayed confirmation cannot apply the adjustment twice (Phase 7).
  proposalId    String?  @unique
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

/// A completed sale. Never edited: a correction voids it and records a new sale
/// (invariant 4). Stock and money effects are written in the same transaction.
model Sale {
  id     String @id @default(cuid())
  /// Human-readable receipt number, e.g. 20261025-0001.
  number String @unique

  /// Sum of the line totals after the sale-level discount.
  totalPaisa    Int
  discountPaisa Int @default(0)
  /// Cash handed over and the change returned. Credit sales (Phase 3) may pay
  /// less than the total and carry the difference on the customer balance.
  paidPaisa     Int
  changePaisa   Int @default(0)

  /// CASH | CREDIT
  paymentMethod String @default("CASH")
  note          String?

  /// Set for credit sales. The khata balance is derived from credit sales minus
  /// payments, never stored on the customer row.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Set by the void workflow (Phase 5). A voided sale stays in the record.
  voidedAt     DateTime?
  voidedReason String?

  /// Set when a sale is created from an assistant proposal. Unique so a
  /// replayed confirmation cannot create a second sale (Phase 7).
  proposalId String? @unique

  createdAt DateTime @default(now())

  items SaleItem[]

  @@index([createdAt])
  @@index([customerId, createdAt])
  @@map("sales")
}

/// One line of a sale, with the price and cost frozen at sale time so later
/// product changes never alter historical profit (invariant 5).
model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String
  /// Order of the line on the receipt, starting at 0.
  position  Int

  /// Snapshots so history survives renames and price changes.
  productName String
  unit        String

  quantityMilli  Int
  unitPricePaisa Int
  unitCostPaisa  Int
  lineTotalPaisa Int
  lineCostPaisa  Int

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// A person who buys on credit. The outstanding balance is derived from
/// non-voided credit sales minus recorded payments, never stored here
/// (invariant 9).
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  /// Set when a customer is created from an assistant proposal. Unique so a
  /// replayed confirmation cannot create a second customer (Phase 7).
  proposalId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  payments Payment[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

/// A repayment against a customer's khata. Positive amount only; the service
/// rejects payments above the outstanding balance inside the transaction.
model Payment {
  id          String   @id @default(cuid())
  customerId  String
  amountPaisa Int
  note        String?
  /// Set when a payment is created from an assistant proposal. Unique so a
  /// replayed confirmation cannot credit the khata twice (Phase 7).
  proposalId  String?  @unique
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("payments")
}

/// A shop expense. Append-only: expenses feed net profit and are never edited.
model Expense {
  id          String   @id @default(cuid())
  /// RENT | ELECTRICITY | SALARIES | TRANSPORT | OTHER
  category    String
  amountPaisa Int
  /// Shop-local midnight of the day the expense belongs to.
  spentAt     DateTime
  note        String?
  /// Set when an expense is created from an assistant proposal. Unique so a
  /// replayed confirmation cannot record the expense twice (Phase 7).
  proposalId  String?  @unique
  createdAt   DateTime @default(now())

  @@index([spentAt])
  @@map("expenses")
}

/// An append-only trail of money and stock changes. Written in the same
/// transaction as the change it describes, so a change cannot exist without
/// its audit row (or the reverse).
model AuditLog {
  id         String   @id @default(cuid())
  /// Signed-in username; legacy rows recorded before sign-in use "local".
  actor      String   @default("local")
  /// For example SALE_CREATED, SALE_VOIDED, PAYMENT_RECORDED.
  action     String
  entityType String
  entityId   String
  summary    String
  /// JSON text of the state before the change; null for a create.
  before     String?
  /// JSON text of the state after the change.
  after      String?
  /// Extra context such as a note or restored stock lines.
  details    String?
  /// Set when the audit row is the idempotency record for an assistant
  /// proposal, currently product edits. Unique so a replay cannot apply the
  /// same update twice (Phase 7).
  proposalId String? @unique
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// The counted cash for one shop day, compared with the expected cash.
/// One record per day; re-running the check updates the same row.
model CashReconciliation {
  id              String   @id @default(cuid())
  /// Shop-local midnight of the reconciled day.
  businessDate    DateTime @unique
  expectedPaisa   Int
  countedPaisa    Int
  differencePaisa Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cash_reconciliations")
}
