# Copy this file to `.env` and adjust values if needed.
# `.env` is ignored by git and must never be committed.

# SQLite database file, relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js signs and encrypts the session cookie with this value.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# The single owner account created by `npm run db:seed`.
# Use a password of at least 8 characters. Re-run the seed after changing it.
OWNER_USERNAME="owner"
OWNER_PASSWORD="replace-with-a-strong-password"
OWNER_NAME="Shopkeeper"
